<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yq.modules.system.mapper.SysUserRoleMapper">

    <resultMap id="SysUserRoleMap" type="cn.yq.modules.system.domain.entity.SysUserRoleEntity">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="roleId" column="role_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectByUserId" resultMap="SysUserRoleMap">
        select id, user_id, role_id, created_at
        from sys_user_role
        where user_id = #{userId}
        order by id asc
    </select>
</mapper>
