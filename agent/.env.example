ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-pro-260215
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_PATH=/embeddings/multimodal
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIMENSIONS=1024
KB_API_KEY=
KB_BASE_URL=http://api-knowledgebase.mlp.cn-beijing.volces.com
KB_SERVICE_RESOURCE_ID=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=student_knowledge_chunks
MILVUS_CODE_COLLECTION=code_knowledge_chunks
MILVUS_DATA_ANALYSIS_COLLECTION=data_analysis_schema_chunks
MILVUS_DATA_ANALYSIS_METRIC_COLLECTION=data_analysis_metric_chunks
MILVUS_VECTOR_DIM=1024
MILVUS_TIMEOUT_S=10
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_ROUTER_MODEL=qwen3.6-flash
QWEN_DATA_ANALYSIS_SQL_MODEL=qwen3.6-flash
QWEN_DATA_ANALYSIS_INTERPRET_MODEL=qwen3.6-flash
QWEN_DATA_ANALYSIS_SQL_MAX_TOKENS=1200
QWEN_DATA_ANALYSIS_INTERPRET_MAX_TOKENS=1600

# 面试复盘 ASR。生产建议使用 volcengine；本地无火山 Key 时可改成 funasr。
INTERVIEW_ASR_PROVIDER=volcengine
# 新版豆包语音控制台只需要 VOLC_SPEECH_API_KEY；旧版控制台使用 APP_KEY + ACCESS_KEY。
VOLC_SPEECH_API_KEY=
VOLC_SPEECH_APP_KEY=
VOLC_SPEECH_ACCESS_KEY=
VOLC_SPEECH_RESOURCE_ID=volc.bigasr.auc
VOLC_SPEECH_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLC_SPEECH_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
VOLC_SPEECH_MODEL_NAME=bigmodel
VOLC_SPEECH_MODEL_VERSION=400
VOLC_SPEECH_SSD_VERSION=200
VOLC_SPEECH_POLL_INTERVAL_S=3
VOLC_SPEECH_MAX_WAIT_S=1800
VOLC_SPEECH_REQUEST_TIMEOUT_S=30
VOLC_SPEECH_MAX_RETRIES=3
# 默认不读取 HTTP_PROXY/HTTPS_PROXY，避免本机代理导致火山连接被 reset。
VOLC_SPEECH_TRUST_ENV_PROXY=false

# AI 模拟面试实时语音。Java 与 Python 的 token secret 必须保持一致。
MOCK_INTERVIEW_REALTIME_TOKEN_SECRET=
MOCK_INTERVIEW_VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
MOCK_INTERVIEW_VOLC_APP_ID=
MOCK_INTERVIEW_VOLC_ACCESS_KEY=
MOCK_INTERVIEW_VOLC_RESOURCE_ID=volc.speech.dialog
MOCK_INTERVIEW_VOLC_APP_KEY=
MOCK_INTERVIEW_VOLC_MODEL=1.2.1.1
MOCK_INTERVIEW_TTS_SPEAKER=zh_male_yunzhou_jupiter_bigtts
MOCK_INTERVIEW_TTS_FORMAT=pcm_s16le
MOCK_INTERVIEW_TTS_SAMPLE_RATE=24000
MOCK_INTERVIEW_AUDIO_FORMAT=pcm
MOCK_INTERVIEW_AUDIO_SAMPLE_RATE=16000
MOCK_INTERVIEW_AUDIO_CHANNEL=1
MOCK_INTERVIEW_CONNECT_TIMEOUT_S=15
